APP_NAME=AI's Eye API
APP_ENV=development
API_PORT=8000
DASHBOARD_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

POSTGRES_USER=store
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_DB=store
POSTGRES_PORT=5432
DATABASE_URL=postgresql://store:change-me-for-local-development@db:5432/store

CORS_ORIGINS=http://localhost:5173
SAMPLE_DATA_DIR=/workspace/samples

# AICC (Gemini) - 둘 중 한 방식을 고른다. 아무것도 안 넣으면 키워드 분기만 동작한다.
# 방식 A) 개인 무료 API 키: https://aistudio.google.com/apikey 에서 발급
GOOGLE_API_KEY=
AICC_GEMINI_MODEL=gemini-flash-lite-latest
# 방식 B) 팀 크레딧(Vertex AI): gcloud 로그인 후 아래 두 줄을 채운다.
#   gcloud auth application-default login
#   프로젝트 ID는 팀에 문의. 이 방식을 쓰면 AICC_GEMINI_MODEL을 gemini-2.5-flash로 둔다.
AICC_VERTEX_PROJECT=
AICC_VERTEX_LOCATION=us-central1
