APP_NAME=AI's Eye API
APP_ENV=development
API_BIND_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_BIND_HOST=0.0.0.0
DASHBOARD_PORT=5173
# 클라우드 대시보드(https://aiseye.ldhcloud.com)용. 브라우저 호스트가 클라우드일 때 사용.
# VITE_CLOUD_API_BASE_URL=https://aiseye-api.ldhcloud.com
# VITE_CLOUD_AICC_BASE_URL=https://aiseye-aicc.ldhcloud.com
# 대용량 업로드는 Cloudflare를 우회하고 Tailscale HTTPS(Serve)로 보낸다.
# VITE_UPLOAD_API_BASE_URL=https://docker-test.tail0c814d.ts.net
# API CORS에도 대시보드 출처를 넣는다:
# CORS_ORIGINS=...,https://aiseye.ldhcloud.com
# AICC_CORS_ORIGINS=...,https://aiseye.ldhcloud.com
VITE_API_BASE_URL=http://localhost:8000
VITE_AICC_BASE_URL=http://localhost:8100
VITE_AUTH_MODE=firebase
# 구역별 현황의 카메라 시점 디지털 트윈 V2. 검토 전 기본값은 false.
VITE_ENABLE_CAMERA_TWIN_V2=true

# Firebase Authentication (웹 설정값은 공개 식별자이며 비공개 키가 아니다.)
AUTH_REQUIRED=true
FIREBASE_PROJECT_ID=your-firebase-project-id
# 로컬 개발은 서비스 계정 JSON 대신 위임 ADC 파일을 사용한다.
FIREBASE_ADC_HOST_PATH=/home/user/.config/ai-s-eye/firebase-adc.json
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-web-app-id
# true면 빠른 체험용 로그인 버튼을 표시한다. production 빌드(미니PC 포함)에서도 동일.
VITE_ENABLE_DEMO_LOGIN=false
VITE_DEMO_STORE_001_EMAIL=
VITE_DEMO_STORE_001_PASSWORD=
VITE_DEMO_STORE_002_EMAIL=
VITE_DEMO_STORE_002_PASSWORD=
VITE_DEMO_ADMIN_EMAIL=
VITE_DEMO_ADMIN_PASSWORD=
# Vision/AICC 등 서버 간 내부 호출에 사용할 충분히 긴 임의 문자열
INTERNAL_API_KEY=replace-with-a-random-secret

POSTGRES_USER=store
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_DB=store
POSTGRES_PORT=5432
DATABASE_URL=postgresql://store:change-me-for-local-development@db:5432/store

CORS_ORIGINS=http://localhost:5173
SAMPLE_DATA_DIR=/workspace/samples
VISION_SNAPSHOT_DIR=/workspace/vision-snapshots
VISION_SNAPSHOT_MAX_BYTES=5242880
VISION_STORE_IDS=store-001,store-002
# 온보딩 업로드 미디어(미니PC 볼륨). 분석은 GPU 워커가 job으로 가져간다.
STORE_MEDIA_DIR=/workspace/store-media
STORE_MEDIA_MAX_BYTES=209715200
STORE_STATE_RETENTION_DAYS=7
STORE_STATE_CLEANUP_INTERVAL_SECONDS=21600

# AICC (Gemini) - 팀 크레딧(Vertex AI) 방식. 아래 gcloud 로그인 한 번만 하면 된다.
#   1) gcloud CLI 설치: https://cloud.google.com/sdk/docs/install
#   2) gcloud init          (본인 구글 계정으로 로그인, 프로젝트는 아래 ID 선택)
#   3) gcloud auth application-default login   (권한 체크박스 전부 켜기)
AICC_VERTEX_PROJECT=project-511b6816-d61a-47ab-b67
AICC_VERTEX_LOCATION=us-central1
AICC_GEMINI_MODEL=gemini-2.5-flash
AICC_BIND_HOST=0.0.0.0
AICC_PORT=8100
AICC_CORS_ORIGINS=http://localhost:5173
AICC_REQUEST_TIMEOUT_SECONDS=5
AICC_DEFAULT_STORE_ID=store-001
# 장면 초안(온보딩 AI 테이블). 본인 GPU Tailscale IP:8200 권장.
# AICC_VISION_SCENE_URL=http://100.x.x.x:8200/internal/scene-suggestions
# vision-replay → API (compose 안에서는 기본 http://api:8000 유지)
# VISION_REPLAY_API_URL=http://api:8000
# VISION_REPLAY_INTERVAL=2
# VISION_REPLAY_SPEED=1


# 공용 카카오 채널 하나로 여러 매장을 안내할 때, 안내 가능한 매장 목록(JSON).
# 여러 개면 손님이 대화에서 매장을 고르고(선택 버튼), QR/링크로 store_id를 넘기면 그 매장으로 바로.
# 새 매장은 여기 한 줄만 추가하면 선택지에 자동 등장한다. 비우거나 1개면 기본 매장으로 바로 답한다.
# AICC_STORE_DIRECTORY=[{"id":"store-001","name":"동명점"},{"id":"store-002","name":"수완점"}]

# 카카오톡 손님 챗봇(스킬 웹훅 POST /kakao/skill) 보호용 공유 토큰.
# 카카오는 요청에 서명을 붙이지 않으므로, 스킬 URL을 아는 아무나 못 부르게 막는다.
# 값을 넣으면 오픈빌더 스킬에 헤더(X-Kakao-Skill-Token) 또는 URL 뒤 ?token= 로 같은 값을
# 넣어야 한다. 비워두면(로컬 개발) 토큰 검사를 건너뛴다.
# AICC_KAKAO_SKILL_TOKEN=

# 미니PC에서 팀 프런트 개발용 무인증 서비스를 열 때만 사용한다.
# docker compose --profile team-dev up -d --build api-dev aicc-dev
API_DEV_BIND_HOST=127.0.0.1
API_DEV_PORT=8001
API_DEV_CORS_ORIGINS=http://localhost:5173
AICC_DEV_BIND_HOST=127.0.0.1
AICC_DEV_PORT=8101
AICC_DEV_CORS_ORIGINS=http://localhost:5173

# Docker에서 Vertex ADC를 쓸 때 호스트 파일의 절대 경로
# GOOGLE_APPLICATION_CREDENTIALS_HOST_PATH=/home/user/.config/gcloud/application_default_credentials.json

# 크레딧을 못 쓰는 경우에만: 개인 무료 API 키 (https://aistudio.google.com/apikey)
# 이 키를 넣고 위 AICC_VERTEX_PROJECT를 비우면 무료 등급으로 동작한다.
# GOOGLE_API_KEY=
