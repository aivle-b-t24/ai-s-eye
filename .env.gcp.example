# GCP Compute Engine CPU VM용 예시. 실제 값은 .env.gcp에 저장하고 Git에 올리지 않는다.
RECAPTCHA_SECRET_KEY=replace-with-recaptcha-secret
# reCAPTCHA v2 사이트키(공개값). 프론트 빌드에 주입 → 값 바꾸면 dashboard 재빌드 필요.
VITE_RECAPTCHA_SITE_KEY=replace-with-recaptcha-site-key
APP_NAME=AI's Eye API
POSTGRES_USER=store
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=store
INTERNAL_API_KEY=replace-with-a-long-random-internal-key

# GCP VM의 실제 HTTPS 주소로 바꾼다. 기존 도메인을 계속 쓰면 CLOUD 값도 동일하게 둔다.
VITE_API_BASE_URL=https://api.example.com
VITE_AICC_BASE_URL=https://aicc.example.com
VITE_UPLOAD_API_BASE_URL=https://api.example.com
VITE_CLOUD_API_BASE_URL=https://api.example.com
VITE_CLOUD_AICC_BASE_URL=https://aicc.example.com
CORS_ORIGINS=https://dashboard.example.com
AICC_CORS_ORIGINS=https://dashboard.example.com

AUTH_REQUIRED=true
FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_AUTH_MODE=firebase
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-web-app-id
VITE_ENABLE_DEMO_LOGIN=false
VITE_ENABLE_CAMERA_TWIN_V2=true

# Compute Engine에 연결한 서비스 계정의 ADC를 사용하므로 JSON 키 파일 경로는 넣지 않는다.
AICC_VERTEX_PROJECT=your-gcp-project-id
AICC_VERTEX_LOCATION=us-central1
# 임베딩 전용 API 키. 비워두면 기존 Vertex 임베딩을 사용한다.
AICC_EMBED_API_KEY=
AICC_GEMINI_MODEL=gemini-2.5-flash
AICC_DEFAULT_STORE_ID=store-001
AICC_STORE_DIRECTORY=[{"id":"store-001","name":"동명점"},{"id":"store-002","name":"수완점"}]

API_BIND_HOST=0.0.0.0
API_PORT=8000
AICC_BIND_HOST=0.0.0.0
AICC_PORT=8100
DASHBOARD_BIND_HOST=0.0.0.0
DASHBOARD_PORT=80

VISION_STORE_IDS=store-001,store-002
VISION_REPLAY_INTERVAL=2
VISION_REPLAY_SPEED=1
STORE_STATE_RETENTION_DAYS=7
STORE_STATE_CLEANUP_INTERVAL_SECONDS=21600
