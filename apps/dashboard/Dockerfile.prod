FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_API_BASE_URL
ARG VITE_AICC_BASE_URL
ARG VITE_UPLOAD_API_BASE_URL
ARG VITE_CLOUD_API_BASE_URL
ARG VITE_CLOUD_AICC_BASE_URL
ARG VITE_AUTH_MODE=firebase
ARG VITE_ENABLE_CAMERA_TWIN_V2=true
ARG VITE_FIREBASE_API_KEY
ARG VITE_FIREBASE_AUTH_DOMAIN
ARG VITE_FIREBASE_PROJECT_ID
ARG VITE_FIREBASE_STORAGE_BUCKET
ARG VITE_FIREBASE_MESSAGING_SENDER_ID
ARG VITE_FIREBASE_APP_ID
# reCAPTCHA v2 Checkbox 사이트키(운영). 비우면 앱이 Google 테스트키로 폴백(항상 통과).
ARG VITE_RECAPTCHA_SITE_KEY
ARG VITE_ENABLE_DEMO_LOGIN=false
ARG VITE_DEMO_STORE_001_EMAIL
ARG VITE_DEMO_STORE_001_PASSWORD
ARG VITE_DEMO_STORE_002_EMAIL
ARG VITE_DEMO_STORE_002_PASSWORD
ARG VITE_DEMO_ADMIN_EMAIL
ARG VITE_DEMO_ADMIN_PASSWORD

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_AICC_BASE_URL=$VITE_AICC_BASE_URL \
    VITE_UPLOAD_API_BASE_URL=$VITE_UPLOAD_API_BASE_URL \
    VITE_CLOUD_API_BASE_URL=$VITE_CLOUD_API_BASE_URL \
    VITE_CLOUD_AICC_BASE_URL=$VITE_CLOUD_AICC_BASE_URL \
    VITE_AUTH_MODE=$VITE_AUTH_MODE \
    VITE_ENABLE_CAMERA_TWIN_V2=$VITE_ENABLE_CAMERA_TWIN_V2 \
    VITE_FIREBASE_API_KEY=$VITE_FIREBASE_API_KEY \
    VITE_FIREBASE_AUTH_DOMAIN=$VITE_FIREBASE_AUTH_DOMAIN \
    VITE_FIREBASE_PROJECT_ID=$VITE_FIREBASE_PROJECT_ID \
    VITE_FIREBASE_STORAGE_BUCKET=$VITE_FIREBASE_STORAGE_BUCKET \
    VITE_FIREBASE_MESSAGING_SENDER_ID=$VITE_FIREBASE_MESSAGING_SENDER_ID \
    VITE_FIREBASE_APP_ID=$VITE_FIREBASE_APP_ID \
    VITE_RECAPTCHA_SITE_KEY=$VITE_RECAPTCHA_SITE_KEY \
    VITE_ENABLE_DEMO_LOGIN=$VITE_ENABLE_DEMO_LOGIN \
    VITE_DEMO_STORE_001_EMAIL=$VITE_DEMO_STORE_001_EMAIL \
    VITE_DEMO_STORE_001_PASSWORD=$VITE_DEMO_STORE_001_PASSWORD \
    VITE_DEMO_STORE_002_EMAIL=$VITE_DEMO_STORE_002_EMAIL \
    VITE_DEMO_STORE_002_PASSWORD=$VITE_DEMO_STORE_002_PASSWORD \
    VITE_DEMO_ADMIN_EMAIL=$VITE_DEMO_ADMIN_EMAIL \
    VITE_DEMO_ADMIN_PASSWORD=$VITE_DEMO_ADMIN_PASSWORD

RUN npm test && npm run build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --retries=5 --start-period=5s \
  CMD wget -q --spider http://127.0.0.1:8080/ || exit 1
