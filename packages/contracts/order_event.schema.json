{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "order_event.schema.json",
  "title": "OrderEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "order_id", "store_id", "occurred_at", "status", "items"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "order_id": {"type": "string", "minLength": 1},
    "store_id": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "status": {
      "type": "string",
      "enum": ["received", "preparing", "ready", "completed", "cancelled", "rejected"]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["menu_id", "quantity"],
        "properties": {
          "menu_id": {"type": "string", "minLength": 1},
          "name": {"type": ["string", "null"]},
          "quantity": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}

